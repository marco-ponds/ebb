{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview",
      "startServerReadyPattern": "4173",
      "startServerReadyTimeout": 30000,
      "url": [
        "http://localhost:4173/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844,
          "deviceScaleFactor": 3,
          "disabled": false
        },
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "pwa"
        ]
      }
    },
    "assert": {
      "assertions": {
        "installable-manifest": [
          "error",
          {
            "minScore": 1
          }
        ],
        "viewport": [
          "error",
          {
            "minScore": 1
          }
        ],
        "themed-omnibox": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:pwa": [
          "error",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
